{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlab.local/schemas/scene.schema.json",
  "title": "SimLabScene",
  "type": "object",
  "$defs": {
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotation": { "$ref": "#/$defs/vector3" },
        "scale": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["position", "rotation", "scale"],
      "additionalProperties": false
    },
    "meshGeometry": {
      "type": "object",
      "properties": {
        "kind": { "const": "mesh" },
        "source_format": { "const": "openusd" },
        "source": { "type": "string", "minLength": 1 },
        "visual_cache": { "type": "string", "minLength": 1 },
        "collision_mesh": { "type": "string", "minLength": 1 },
        "bounds": {
          "type": "object",
          "properties": {
            "min": { "$ref": "#/$defs/vector3" },
            "max": { "$ref": "#/$defs/vector3" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "source_format", "source", "visual_cache", "collision_mesh"],
      "additionalProperties": false
    },
    "quadrotorRotor": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "link_id": { "type": "string", "minLength": 1 },
        "actuator_id": { "type": "string", "minLength": 1 },
        "axis": { "$ref": "#/$defs/vector3" },
        "direction": { "enum": [-1, 1] },
        "thrust_coefficient": { "type": "number", "exclusiveMinimum": 0 },
        "torque_coefficient": { "type": "number", "minimum": 0 },
        "min_angular_velocity": { "type": "number", "minimum": 0 },
        "max_angular_velocity": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": [
        "id",
        "link_id",
        "actuator_id",
        "axis",
        "direction",
        "thrust_coefficient",
        "torque_coefficient",
        "min_angular_velocity",
        "max_angular_velocity"
      ],
      "additionalProperties": false
    },
    "quadrotorPropulsion": {
      "type": "object",
      "properties": {
        "type": { "const": "quadrotor" },
        "model": { "const": "quadratic" },
        "command_mode": { "const": "angular_velocity" },
        "body_link_id": { "type": "string", "minLength": 1 },
        "rotors": {
          "type": "array",
          "items": { "$ref": "#/$defs/quadrotorRotor" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["type", "model", "command_mode", "body_link_id", "rotors"],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^actor_[0-9]{3,}$" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["object", "robot", "terrain", "camera", "light"]
        },
        "asset_id": { "type": "string" },
        "transform": { "$ref": "#/$defs/transform" },
        "properties": {
          "type": "object",
          "properties": {
            "primitive": {
              "type": "string",
              "enum": ["box", "sphere", "cylinder", "ellipsoid", "plane"]
            },
            "size": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0 },
              "minItems": 1,
              "maxItems": 3
            },
            "rgba": {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 4,
              "maxItems": 4
            },
            "geometry": { "$ref": "#/$defs/meshGeometry" },
            "import_warnings": {
              "type": "array",
              "items": { "type": "string" }
            },
            "physics": { "$ref": "physics.schema.json" },
            "propulsion": { "$ref": "#/$defs/quadrotorPropulsion" }
          },
          "additionalProperties": true
        }
      },
      "required": ["id", "name", "type", "asset_id", "transform", "properties"],
      "additionalProperties": false
    },
    "trajectoryClip": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^trajectory_[A-Za-z0-9_.-]+$" },
        "actor_id": { "type": "string", "pattern": "^actor_[0-9]{3,}$" },
        "trajectory": { "$ref": "joint-trajectory.schema.json" }
      },
      "required": ["id", "actor_id", "trajectory"],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^attachment_[A-Za-z0-9_.-]+$" },
        "type": { "enum": ["connect", "weld"] },
        "parent_body_id": { "type": "string", "minLength": 1 },
        "child_body_id": { "type": "string", "minLength": 1 },
        "parent_anchor": { "$ref": "#/$defs/vector3" },
        "child_anchor": { "$ref": "#/$defs/vector3" },
        "initially_active": { "type": "boolean" },
        "capture_distance": { "type": "number", "exclusiveMinimum": 0 },
        "capture_speed": { "type": "number", "exclusiveMinimum": 0 },
        "capture_duration": { "type": "number", "minimum": 0 },
        "require_contact": { "type": "boolean" },
        "contact_probe_radius": { "type": "number", "minimum": 0 },
        "gripper": { "$ref": "#/$defs/vacuumGripper" },
        "solref": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "solimp": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 5,
          "maxItems": 5
        }
      },
      "required": [
        "id",
        "type",
        "parent_body_id",
        "child_body_id",
        "parent_anchor",
        "child_anchor",
        "initially_active",
        "capture_distance",
        "capture_speed",
        "capture_duration",
        "require_contact",
        "contact_probe_radius",
        "solref",
        "solimp"
      ],
      "additionalProperties": false
    },
    "vacuumGripper": {
      "type": "object",
      "properties": {
        "type": { "const": "four_cup_vacuum" },
        "plate_half_extents": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "cup_offset": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "cup_radius": { "type": "number", "exclusiveMinimum": 0 },
        "cup_height": { "type": "number", "exclusiveMinimum": 0 },
        "mount_radius": { "type": "number", "exclusiveMinimum": 0 },
        "mount_length": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": [
        "type",
        "plate_half_extents",
        "cup_offset",
        "cup_radius",
        "cup_height",
        "mount_radius",
        "mount_length"
      ],
      "additionalProperties": false
    },
    "deliveryTask": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^task_[A-Za-z0-9_.-]+$" },
        "type": { "const": "aerial_delivery" },
        "attachment_id": { "type": "string", "minLength": 1 },
        "payload_body_id": { "type": "string", "minLength": 1 },
        "pickup_position": { "$ref": "#/$defs/vector3" },
        "dropoff_position": { "$ref": "#/$defs/vector3" },
        "position_tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "settle_speed": { "type": "number", "exclusiveMinimum": 0 },
        "settle_duration": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": [
        "id",
        "type",
        "attachment_id",
        "payload_body_id",
        "pickup_position",
        "dropoff_position",
        "position_tolerance",
        "settle_speed",
        "settle_duration"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "units": { "type": "string", "enum": ["meters"] },
    "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } },
    "robotics": { "$ref": "robotics.schema.json" },
    "trajectories": {
      "type": "array",
      "items": { "$ref": "#/$defs/trajectoryClip" }
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachment" }
    },
    "delivery_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/deliveryTask" }
    },
    "simulation_config": {
      "type": "object",
      "properties": {
        "timestep": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "physics_engine": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "deprecated": true
        },
        "solvers": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_.-]*$"
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_.-]*$"
                  },
                  "uniqueItems": true
                }
              },
              "required": ["primary"],
              "additionalProperties": false
            }
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "rigid_body",
              "articulation",
              "collision",
              "constraint",
              "external_force",
              "ray_query",
              "fluid",
              "particle",
              "deformable_body",
              "differentiable"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": ["timestep", "duration"],
      "additionalProperties": true
    }
  },
  "required": ["version", "name", "units", "actors", "simulation_config"],
  "additionalProperties": false
}
