{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "frontend/src/ts",
    "outDir": "frontend/generated",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["frontend/src/ts/**/*.ts", "frontend/src/ts/**/*.d.ts"]
}
